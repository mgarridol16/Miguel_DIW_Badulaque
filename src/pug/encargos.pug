extends layout.pug

block content

  main.container.fondo2.main-content
    .row.titulo2
      .twelve.columns
        h2 ¡Queremos Escucharte!
        h3 Sugiere Nuevas Chuches
        p Ayudanos a traer los dulces que más te gustan
      .row.contendorImagenes
        form(action="/encargos" method="POST")
          .four.columns
            label(for="Nombre") Nombre del Producto:
            input(type="text" name="nombreProducto" placeholder="nombre del producto" required)
          .four.columns
            label(for="Marca")  Marca del Producto:
            input(type="text" id="Marca" name="Marca" placeholder="Marca del producto" required)
          .four.columns
            label(for="Categoria") Categoria del Producto:
            select#(name="Cateogira" id="categoria" required)
              option(value="" disabled selected) categoria
              option(value="Gominolas") Gominolas
              option(value="Chocolates") Chocolates
              option(value="Regaliz") Regaliz
              option(value="Otros") Otros
      .row.contendorImagenes
        h3 ¿Donde lo hasvisto?
        .twelve.columns
          label(for="Tienda") Inserta la sugerencia de donde lo has visto:
          input(type="text" id="Tienda" name="Tienda" placeholder="Sitio" required style="width: 300px; height: 50px; maxlength: 50;")
      .row.contendorImagenes
        .twelve.columns
          label(for="correo") Insertta tu correo electrónico para contactarte:
          input(type="email" id="correo" name="correo" placeholder="correo electrónico" required style="width: 300px; height: 50px; maxlength: 50;")
      .row.contendorImagenes
        .twelve.columns
          label(for="terminos") He leido los terminos y condiciones y estoy de acuerdo
          input(type="checkbox"id="terminos" name="terminos")
      .row.contendorImagenes
        .twelve.columns
          button.button-principal(type="submit") Enviar Sugerencia
