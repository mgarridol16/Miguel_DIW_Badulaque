extends partials/layout.pug

block content

  .row.titulo2
    .twelve.columns
      h2 ¡Queremos Escucharte!
      h3 Sugiere Nuevas Chuches
      p Ayúdanos a traer los dulces que más te gustan

  .row.contendorImagenes
    form(action="/encargos" method="POST")
      .four.columns.four-lg.columns
        label(for="nombreProducto") Nombre del Producto:
        input(type="text" id="nombreProducto" name="nombreProducto" placeholder="Nombre del producto" required)

      .four.columns.four-lg.columns
        label(for="Marca") Marca del Producto:
        input(type="text" id="Marca" name="Marca" placeholder="Marca del producto" required)

      .four.columns.four-lg.columns
        label(for="Categoria") Categoría del Producto:
        select(name="Categoria" id="categoria" required)
          option(value="" disabled selected) Categoría
          option(value="Gominolas") Gominolas
          option(value="Chocolates") Chocolates
          option(value="Regaliz") Regaliz
          option(value="Otros") Otros

      .row.contendorImagenes
        h3 ¿Dónde lo has visto?
        .twelve.columns
          label(for="Tienda") Inserta la sugerencia de dónde lo has visto:
          input(type="text" id="Tienda" name="Tienda" placeholder="Sitio" required maxlength="50")

      .row.contendorImagenes
        .twelve.columns
          label(for="correo") Inserta tu correo electrónico para contactarte:
          input(type="email" id="correo" name="correo" placeholder="Correo electrónico" required maxlength="50")

      .row.contendorImagenes
        .twelve.columns
          input(type="checkbox" id="terminos" name="terminos")
          label(for="terminos") He leído los términos y condiciones y estoy de acuerdo

      .row.contendorImagenes
        .twelve.columns
          button.button-principal(type="submit") Enviar Sugerencia
