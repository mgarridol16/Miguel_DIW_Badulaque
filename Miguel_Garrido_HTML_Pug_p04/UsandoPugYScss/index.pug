doctype html
html(lang="en")
    head
        meta(charset="UTF-8")
        meta(name="viewport" content="width=device-width, initial-scale=1.0")
        title Registro de MACs
        link(rel="stylesheet" href="estilos.css")
    body
        header
            h2 REGISTRO MACs IES GREGORIO PRIETO

        aside
            form(action="")
                .nombre
                    label(for="name") Introduce tu nombre:
                    input(type="text")

                .clase
                    label(for="clase") Selecciona la clase
                    select.clases(name="clase")
                        option(selected disabled) clase
                        option(value="1-DAW") 1-DAW
                        option(value="1-DAM") 1-DAM
                        option(value="2-DAW") 2-DAW
                        option(value="2-DAM") 2-DAM

                .rol
                    p Selecciona tu rol
                    label(for="alumno") alumno
                    input(type="radio" name="rol")
                    label(for="profesor") profesor
                    input(type="radio" name="rol")

                .macs
                    label(for="macs") Introduce tu Macs
                    input(type="text")

                input.botton(type="button" value="Enviar")

        section
            table.listado
                tr
                    th MACS Introducidas
                tr
                    td
                        span 09:04:4D:31:A4
                        button.bottonMacsEdit ✏️
                        button.bottonMacsDelete ❌
                tr
                    td
                        span 09:04:4D:31:A4
                        button.bottonMacsEdit ✏️
                        button.bottonMacsDelete ❌

        footer
            p Registro de MACs - 2 DAW - MIGUEL GARRIDO LEÓN
